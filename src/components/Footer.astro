---
const { lang = 'es' } = Astro.props
const isEn = lang === 'en'
---

<footer class="border-t border-[var(--color-border)] bg-[var(--color-surface)]/50 mt-16">
  <div class="max-w-6xl mx-auto px-4 py-8">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-[var(--color-ink-light)]">
      <div class="flex items-center gap-1">
        <span class="font-bold text-[var(--color-ink)]">alt/</span>
        <span>&mdash; {isEn ? 'Find better. Pay less.' : 'Encuentra mejor. Paga menos.'}</span>
      </div>
      <div class="flex gap-4 flex-wrap justify-center">
        <a href={isEn ? '/en/tools' : '/herramientas'} class="hover:text-[var(--color-ink)] transition-colors no-underline">
          {isEn ? 'Categories' : 'Categorías'}
        </a>
        <a href="/open-source" class="hover:text-[var(--color-ink)] transition-colors no-underline">
          Open Source
        </a>
        <a href="/blog" class="hover:text-[var(--color-ink)] transition-colors no-underline">
          Blog
        </a>
        <a href="/about" class="hover:text-[var(--color-ink)] transition-colors no-underline">
          {isEn ? 'About' : 'Sobre alt/'}
        </a>
        <a href="/privacidad" class="hover:text-[var(--color-ink)] transition-colors no-underline">
          {isEn ? 'Privacy' : 'Privacidad'}
        </a>
        <a href="/terminos" class="hover:text-[var(--color-ink)] transition-colors no-underline">
          {isEn ? 'Terms' : 'Términos'}
        </a>
        <a href={isEn ? `/en` : `/`} class="hover:text-[var(--color-ink)] transition-colors no-underline">
          {isEn ? 'English' : 'Español'}
        </a>
      </div>
    </div>
    <div class="text-center text-xs text-[var(--color-border)] mt-6">
      &copy; {new Date().getFullYear()} alt/ &mdash; {isEn ? 'We earn commissions from some links. This does not affect our rankings.' : 'Ganamos comisiones de algunos enlaces. Esto no afecta nuestras valoraciones.'}
    </div>
  </div>
</footer>
