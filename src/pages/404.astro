---
import BaseLayout from '@/layouts/BaseLayout.astro'
---

<BaseLayout title="Página no encontrada - alt/" description="La página que buscas no existe." lang="es" showAds={false}>
  <div class="min-h-[60vh] flex flex-col items-center justify-center max-w-6xl mx-auto px-4 py-20 text-center">
    <div class="w-20 h-20 rounded-2xl bg-[var(--color-green-bg)] flex items-center justify-center mb-8">
      <span class="text-3xl font-bold tracking-tight text-[var(--color-ink)]">alt<span class="text-[var(--color-green)]">/</span></span>
    </div>
    <h1 class="text-6xl sm:text-8xl font-bold text-[var(--color-ink)] mb-6">404</h1>
    <h2 class="text-2xl font-semibold text-[var(--color-ink)] mb-4">Página no encontrada</h2>
    <p class="text-lg text-[var(--color-ink-light)] mb-10 max-w-lg mx-auto leading-relaxed">
      Vaya, parece que te has perdido. La página que buscas no existe o ha sido movida de sitio.
    </p>
    <a href="/" class="inline-block px-6 py-3 rounded-xl bg-[var(--color-green)] text-white font-medium hover:bg-[var(--color-green-light)] transition-colors no-underline">
      Volver al inicio
    </a>
  </div>
</BaseLayout>
