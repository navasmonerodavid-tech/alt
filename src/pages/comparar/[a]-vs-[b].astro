---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getHreflang } from '@/lib/hreflang'
import { getToolContent } from '@/lib/tool-content'
import { tools as mockTools } from '@/lib/seed-data'

export async function getStaticPaths() {
  const pairs = [
    ['notion', 'obsidian'], ['slack', 'discord'], ['figma', 'penpot'],
    ['trello', 'asana'], ['asana', 'clickup'], ['notion', 'clickup'],
    ['zapier', 'make'], ['zapier', 'n8n'], ['make', 'n8n'],
    ['mailchimp', 'brevo'], ['hubspot', 'pipedrive'], ['hubspot', 'zoho-crm'],
    ['semrush', 'ahrefs'], ['canva', 'figma'], ['google-analytics', 'plausible'],
    ['shopify', 'woocommerce'], ['slack', 'mattermost'],
  ]
  return pairs.map(([a, b]) => ({ params: { a, b } }))
}

const { a, b } = Astro.params

const toolA = mockTools.find(t => t.slug === a)
const toolB = mockTools.find(t => t.slug === b)
const contentA = getToolContent(a!)
const contentB = getToolContent(b!)

const title = `${toolA?.name || a} vs ${toolB?.name || b}: ¿cuál elegir en 2026?`
const desc = `Comparativa real entre ${toolA?.name || a} y ${toolB?.name || b}: precios, funcionalidades, pros, contras y valoraciones. Descubre cuál es mejor para ti.`

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description: desc,
  mainEntity: {
    '@type': 'Product',
    name: toolA?.name || a,
  },
}

const allFeatures = [
  ...(contentA.features_es || []),
  ...(contentB.features_es || []),
]
const commonFeatures = allFeatures.filter(f =>
  (contentA.features_es || []).some(fa => fa.toLowerCase().includes(f.toLowerCase().slice(0, 10))) &&
  (contentB.features_es || []).some(fb => fb.toLowerCase().includes(f.toLowerCase().slice(0, 10)))
)
---

<BaseLayout title={title} description={desc} lang="es" canonical={`/comparar/${a}-vs-${b}`} schema={schema} hreflang={getHreflang('comparison', `${a}-vs-${b}`)}>
  <div class="max-w-6xl mx-auto px-4 py-8">
    <nav class="text-sm text-[var(--color-ink-light)] mb-6">
      <a href="/" class="hover:text-[var(--color-ink)] transition-colors no-underline">Inicio</a>
      <span class="mx-2">/</span>
      <span class="text-[var(--color-ink)]">{a} vs {b}</span>
    </nav>

    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-[var(--color-ink)] mb-6">
      {toolA?.name || a}
      <span class="text-[var(--color-green)] mx-2">vs</span>
      {toolB?.name || b}
    </h1>

    <p class="text-lg text-[var(--color-ink-light)] mb-10 max-w-3xl">
      ¿Estás dudando entre {toolA?.name || a} y {toolB?.name || b}?
      Aquí tienes una comparativa lado a lado con datos reales de precios, valoraciones y funcionalidades.
      No hay una herramienta "mejor" para todos: depende de tu caso de uso concreto.
    </p>

    <!-- Side-by-side cards -->
    <div class="grid md:grid-cols-2 gap-6 mb-10">
      {[toolA, toolB].map(tool => (
        <div class="bg-[var(--color-surface)] border border-[var(--color-border)] rounded-xl p-6">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-12 h-12 rounded-lg bg-[var(--color-green-bg)] flex items-center justify-center shrink-0 overflow-hidden">
              {tool?.logo_url ? (
                <img src={tool.logo_url} alt={tool.name} class="w-8 h-8 object-contain" loading="lazy" />
              ) : (
                <span class="text-lg font-bold text-[var(--color-green)]">{tool?.name?.[0] || '?'}</span>
              )}
            </div>
            <h2 class="text-xl font-bold text-[var(--color-ink)]">{tool?.name || '?'}</h2>
          </div>

          <dl class="space-y-2 text-sm">
            <div class="flex justify-between py-1.5 border-b border-[var(--color-border-light)]">
              <dt class="text-[var(--color-ink-light)]">Precio</dt>
              <dd class="font-medium text-[var(--color-ink)]">
                {tool?.price_model === 'free' ? 'Gratis' : tool?.price_starting ? `Desde ${tool.price_starting}€/mes` : 'Freemium'}
              </dd>
            </div>
            <div class="flex justify-between py-1.5 border-b border-[var(--color-border-light)]">
              <dt class="text-[var(--color-ink-light)]">Valoración G2</dt>
              <dd class="font-medium text-[var(--color-ink)]">{tool?.rating_g2 ? `⭐ ${tool.rating_g2}/5` : '-'}</dd>
            </div>
            <div class="flex justify-between py-1.5 border-b border-[var(--color-border-light)]">
              <dt class="text-[var(--color-ink-light)]">Open Source</dt>
              <dd class="font-medium text-[var(--color-ink)]">{tool?.is_open_source ? 'Sí ✅' : 'No'}</dd>
            </div>
            <div class="flex justify-between py-1.5 border-b border-[var(--color-border-light)]">
              <dt class="text-[var(--color-ink-light)]">Categoría</dt>
              <dd class="font-medium text-[var(--color-ink)]">{tool?.tags?.[0] || '-'}</dd>
            </div>
          </dl>

          <p class="text-sm text-[var(--color-ink-light)] mt-4 leading-relaxed">{tool?.description_es}</p>

          <div class="mt-4 flex gap-3">
            <a href={`/alternativas-a/${tool?.slug}`}
              class="text-sm font-medium text-[var(--color-green)] hover:underline no-underline">
              Ver alternativas →
            </a>
            <a href={tool?.website_url || '#'} target="_blank" rel="nofollow"
              class="text-sm font-medium px-4 py-1.5 rounded-lg bg-[var(--color-green)] text-white hover:bg-[var(--color-green-light)] transition-colors no-underline">
              Visitar web
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Features Comparison Table -->
    {(contentA.features_es.length > 0 || contentB.features_es.length > 0) && (
      <section class="mb-10">
        <h2 class="text-xl font-bold mb-4 text-[var(--color-ink)]">⚡ Comparativa de funcionalidades</h2>
        <div class="overflow-x-auto">
          <table class="w-full text-sm bg-[var(--color-surface)] border border-[var(--color-border)] rounded-xl overflow-hidden">
            <thead>
              <tr class="bg-[var(--color-cream)] border-b border-[var(--color-border)]">
                <th class="text-left p-4 font-semibold text-[var(--color-ink)]">Funcionalidad</th>
                <th class="text-center p-4 font-semibold text-[var(--color-ink)]">{toolA?.name || a}</th>
                <th class="text-center p-4 font-semibold text-[var(--color-ink)]">{toolB?.name || b}</th>
              </tr>
            </thead>
            <tbody>
              {allFeatures.slice(0, 15).map(f => (
                <tr class="border-b border-[var(--color-border-light)] last:border-0">
                  <td class="p-4 text-[var(--color-ink)]">{f}</td>
                  <td class="p-4 text-center">
                    {contentA.features_es.some(fa => fa.toLowerCase().includes(f.toLowerCase().slice(0, 10))) ? <span class="text-[var(--color-green)] font-bold">✓</span> : <span class="text-[var(--color-red)]">✗</span>}
                  </td>
                  <td class="p-4 text-center">
                    {contentB.features_es.some(fb => fb.toLowerCase().includes(f.toLowerCase().slice(0, 10))) ? <span class="text-[var(--color-green)] font-bold">✓</span> : <span class="text-[var(--color-red)]">✗</span>}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    <!-- Pros & Cons Side by Side -->
    <div class="grid md:grid-cols-2 gap-6 mb-10">
      <!-- Tool A Pros/Cons -->
      <div class="space-y-4">
        <h2 class="text-lg font-bold text-[var(--color-ink)]">
          ✅ {toolA?.name || a}: fortalezas y debilidades
        </h2>
        {contentA.pros_es.length > 0 && (
          <div class="bg-[var(--color-green-bg)] border border-[var(--color-green)]/20 rounded-xl p-4">
            <h3 class="font-semibold text-[var(--color-green)] text-sm mb-2">Ventajas</h3>
            <ul class="space-y-1">
              {contentA.pros_es.map(p => <li class="text-sm text-[var(--color-ink)] flex gap-2"><span>+</span> {p}</li>)}
            </ul>
          </div>
        )}
        {contentA.cons_es.length > 0 && (
          <div class="bg-red-50 border border-red-200 rounded-xl p-4">
            <h3 class="font-semibold text-red-600 text-sm mb-2">Desventajas</h3>
            <ul class="space-y-1">
              {contentA.cons_es.map(c => <li class="text-sm text-[var(--color-ink)] flex gap-2"><span>-</span> {c}</li>)}
            </ul>
          </div>
        )}
        {contentA.best_for_es && (
          <p class="text-sm text-[var(--color-ink-light)]">
            🎯 <strong>Ideal para:</strong> {contentA.best_for_es}
          </p>
        )}
      </div>

      <!-- Tool B Pros/Cons -->
      <div class="space-y-4">
        <h2 class="text-lg font-bold text-[var(--color-ink)]">
          ✅ {toolB?.name || b}: fortalezas y debilidades
        </h2>
        {contentB.pros_es.length > 0 && (
          <div class="bg-[var(--color-green-bg)] border border-[var(--color-green)]/20 rounded-xl p-4">
            <h3 class="font-semibold text-[var(--color-green)] text-sm mb-2">Ventajas</h3>
            <ul class="space-y-1">
              {contentB.pros_es.map(p => <li class="text-sm text-[var(--color-ink)] flex gap-2"><span>+</span> {p}</li>)}
            </ul>
          </div>
        )}
        {contentB.cons_es.length > 0 && (
          <div class="bg-red-50 border border-red-200 rounded-xl p-4">
            <h3 class="font-semibold text-red-600 text-sm mb-2">Desventajas</h3>
            <ul class="space-y-1">
              {contentB.cons_es.map(c => <li class="text-sm text-[var(--color-ink)] flex gap-2"><span>-</span> {c}</li>)}
            </ul>
          </div>
        )}
        {contentB.best_for_es && (
          <p class="text-sm text-[var(--color-ink-light)]">
            🎯 <strong>Ideal para:</strong> {contentB.best_for_es}
          </p>
        )}
      </div>
    </div>

    <!-- Pricing Comparison -->
    {(contentA.pricing_tiers.length > 0 || contentB.pricing_tiers.length > 0) && (
      <section class="mb-10">
        <h2 class="text-xl font-bold mb-4 text-[var(--color-ink)]">💰 Comparativa de precios</h2>
        <div class="grid md:grid-cols-2 gap-6">
          {[
            { name: toolA?.name || a, tiers: contentA.pricing_tiers },
            { name: toolB?.name || b, tiers: contentB.pricing_tiers },
          ].map(col => (
            <div class="space-y-2">
              <h3 class="font-semibold text-[var(--color-ink)]">{col.name}</h3>
              {col.tiers.length > 0 ? col.tiers.map(tier => (
                <div class="bg-[var(--color-surface)] border border-[var(--color-border)] rounded-lg p-3 flex justify-between items-center">
                  <span class="text-sm font-medium text-[var(--color-ink)]">{tier.name}</span>
                  <span class="text-sm font-bold text-[var(--color-green)]">
                    {tier.price_monthly === 0 ? 'Gratis' : `${tier.price_monthly}€/mes`}
                  </span>
                </div>
              )) : (
                <p class="text-sm text-[var(--color-ink-light)]">Precios no disponibles</p>
              )}
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Verdict -->
    <div class="bg-[var(--color-green-bg)] border border-[var(--color-green)]/20 rounded-2xl p-6 text-center">
      <h3 class="text-lg font-semibold mb-2 text-[var(--color-ink)]">📊 Nuestra recomendación</h3>
      <p class="text-sm text-[var(--color-ink-light)] max-w-2xl mx-auto">
        La elección entre {toolA?.name || a} y {toolB?.name || b} depende de tus necesidades específicas.
        Si buscas algo {toolA?.price_model === 'free' ? 'gratuito' : 'económico'}, {toolA?.name || a} es buena opción.
        Si necesitas funcionalidades avanzadas, explora también las alternativas de cada herramienta.
      </p>
      <div class="flex justify-center gap-4 mt-4">
        <a href={`/alternativas-a/${a}`}
          class="text-sm font-medium text-[var(--color-green)] hover:underline no-underline">
          Alternativas a {toolA?.name || a} →
        </a>
        <a href={`/alternativas-a/${b}`}
          class="text-sm font-medium text-[var(--color-green)] hover:underline no-underline">
          Alternativas a {toolB?.name || b} →
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
