---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getCategories } from '@/lib/data'

const categories = await getCategories()

const title = "Todas las categorías de herramientas SaaS"
const description = "Explora nuestro directorio completo de alternativas SaaS organizado por categorías. Encuentra la herramienta perfecta para tu negocio."
---

<BaseLayout title={title} description={description} lang="es" canonical="/herramientas">
  <div class="max-w-6xl mx-auto px-4 py-8">
    <nav class="text-sm text-[var(--color-ink-light)] mb-6">
      <a href="/" class="hover:text-[var(--color-ink)] transition-colors no-underline">Inicio</a>
      <span class="mx-2">/</span>
      <span class="text-[var(--color-ink)]">Categorías</span>
    </nav>
    <h1 class="text-3xl font-bold tracking-tight text-[var(--color-ink)] mb-8">
      {title}
    </h1>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
      {categories.map(cat => (
        <a
          href={`/herramientas/${cat.slug}`}
          class="flex items-center gap-3 p-4 bg-white border border-[var(--color-border)] rounded-xl hover:border-[var(--color-green)] hover:shadow-sm transition-all no-underline"
        >
          <span class="text-2xl">{cat.icon}</span>
          <span class="text-base font-medium text-[var(--color-ink)]">{cat.name_es}</span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
