# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (email para formulario sugerir herramienta)
RESEND_API_KEY=re_xxxxx
RESEND_FROM=alt@altsaas.com

# Polar.sh (pagos por listings)
POLAR_ACCESS_TOKEN=polar_xxx
POLAR_ORGANIZATION_ID=xxx

# IA para contenido (opcional al inicio - usar Groq gratis)
GROQ_API_KEY=gsk_xxxxx

# Site
SITE_URL=https://alt-dusky.vercel.app

# ============================================================
# PUBLICIDAD / ADSENSE (Opcional - Desactivado por defecto)
# ============================================================
# Para activar los anuncios y banners publicitarios:
# 1. Cambia PUBLIC_ADS_ENABLED a 'true'
# 2. Añade tu ID de Google AdSense en PUBLIC_ADSENSE_CLIENT
# 
# Ejemplo:
# PUBLIC_ADS_ENABLED=true
# PUBLIC_ADSENSE_CLIENT="ca-pub-XXXXXXXXXXXXXXXX"
#
# Notas:
# - Por defecto está desactivado (showAds=false en las páginas)
# - Los anuncios NO se muestran hasta que actives estas variables
# - Una vez activado, puedes controlar showAds desde cada página
# ============================================================
PUBLIC_ADS_ENABLED=false
# PUBLIC_ADSENSE_CLIENT="ca-pub-XXXXXXXXXXXXXXXX"
